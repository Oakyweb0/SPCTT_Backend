# ==============================================================================
# SPCTT 2026 BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE / EXAMPLE
# ==============================================================================
NODE_ENV=development
PORT=5000

# Base URL settings
APP_URL=https://api.spctt.org
CLIENT_URL=https://spctt.org,https://api.spctt.org,https://spctt2026.org,https://api.spctt2026.org,http://localhost:3000,http://localhost:5173,http://localhost:5000,*

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=spctt_db
DB_CONNECTION_LIMIT=10

# Security / Authentication
JWT_SECRET=SPCTT_SECURE_JWT_SECRET_KEY_2026_CHANGE_ME
JWT_EXPIRES_IN=24h

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ABSTRACT_MAX_FILE_SIZE_MB=1

# Cloudflare R2 Object Storage Configuration
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET_NAME=spctt2027
R2_FOLDER=Abstract_pdf
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_URL=https://your-r2-public-domain.r2.dev

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_live_Tez11VR2n8IxWl
RAZORPAY_KEY_SECRET=4QeUB9Gf5060EF4zUDKc6UE0
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_CURRENCY=INR

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="SPCTT 2027" <spctt2027@spctt.org>
EMAIL_CC_DEFAULT=admin@spctt.org
